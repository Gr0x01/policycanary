  "enrichments": [
    {
      "id": "c406d2d9-2856-4337-918d-149017a0bf3c",
      "item_id": "135abea0-049d-4d7e-a9b9-f05c85176bea",
      "summary": "The FDA's Human Foods Program issued a guidance document detailing recommendations for manufacturers and suppliers preparing Food Contact Notification (FCN) submissions for food contact substances used with infant formula and human milk. This covers infant formula packaging, baby bottles, bottle inserts, nipples, and other infant food contact materials.",
      "key_regulations": [
        "FDA-2016-D-1814"
      ],
      "key_entities": [
        "Human Foods Program",
        "Food and Drug Administration"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": null
    },
    {
      "id": "96af2e99-12cb-4e37-87ec-04ae0d44aa4a",
      "item_id": "2390e6c3-7653-40e2-85a6-769674e06656",
      "summary": "The FDA issued a Guidance for Industry on how manufacturers of food ingredients and food contact substances should assess the effects of significant manufacturing process changes, such as adopting emerging technologies like nanotechnology, on a product's safety and regulatory status.",
      "key_regulations": [
        "21 CFR 10.115(g)(5)"
      ],
      "key_entities": [
        "Food and Drug Administration",
        "Human Foods Program"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": null
    },
    {
      "id": "9972f978-ccea-4c19-babc-bfb0ad376d48",
      "item_id": "3aea4238-020f-4cbd-9b01-9024b32b2fdf",
      "summary": "The FDA has issued a final rule declaring a Food Contact Substance Notification to be no longer effective. This action, effective May 21, 2024, revokes the authorization for the use of an unspecified substance in food contact applications under that specific notification.",
      "key_regulations": [
        "21 CFR Part 170"
      ],
      "key_entities": [
        "FDA"
      ],
      "regulatory_action_type": "ban_restriction",
      "deadline": "2024-05-21"
    },
    {
      "id": "338f7f0f-b308-4ee8-91ca-29533e06c16b",
      "item_id": "3c5bfdb4-3a13-4e98-a0c3-e31f8dad279b",
      "summary": "NAFCO has initiated a recall for its WHITING FILLET SKIN-ON BONELESS IQF, 2 lb. cases, due to an incorrect \"best by\" date (1-11-2025) printed on the retail bags. The correct best-by date is 1-11-2027.",
      "key_regulations": [],
      "key_entities": [
        "NAFCO"
      ],
      "regulatory_action_type": "recall",
      "deadline": null
    },
    {
      "id": "123dbe9e-9924-4a1e-b4cf-38e14a5608cc",
      "item_id": "6afb44a6-ef04-4b73-94b2-90a4a1642f6a",
      "summary": "The FDA's Human Foods Program issued a revised guidance for industry on the preparation of Food Contact Substance Notifications, specifically detailing toxicology recommendations. The guidance clarifies the scientific information and data needed to establish the safety of food additives that serve as food contact substances (FCSs) under Section 409 of the FD&C Act.",
      "key_regulations": [
        "FD&C Act Section 409(h)(6)",
        "FD&C Act Section 409(a)(3)",
        "FD&C Act Section 409(b)",
        "21 CFR Parts 173-178",
        "21 CFR 170.39"
      ],
      "key_entities": [
        "Food and Drug Administration",
        "Human Foods Program"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": null
    },
    {
      "id": "2f07cf92-08a3-4e72-a750-2d9fcbd8bd07",
      "item_id": "d640e182-2611-4a87-a8d7-7485d92ceb81",
      "summary": "The FDA is requesting information regarding Per- and Polyfluoroalkyl Substances (PFAS) in seafood. This is a public notice seeking data and comments to inform potential future actions regarding PFAS contamination in the seafood supply.",
      "key_regulations": [],
      "key_entities": [
        "FDA"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": "2025-02-18"
    },
    {
      "id": "eca47867-e5ef-4ee2-b587-74d4d22ce136",
      "item_id": "e2b74cee-c9a3-4aee-a480-6875116bb97b",
      "summary": "The FDA issued a revised guidance document for industry detailing the administrative process and scientific requirements for preparing Food Contact Substance Notifications (FCNs). The guidance outlines that FCNs must contain scientific data demonstrating safety comparable to food additive petitions or Threshold of Regulation submissions.",
      "key_regulations": [
        "Section 409 of the FD&C Act",
        "21 CFR 170.39"
      ],
      "key_entities": [
        "Food and Drug Administration"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": null
    },
    {
      "id": "bf9c3a1d-d9ba-4cf9-8a31-34018b375aee",
      "item_id": "e6aa2c7c-2156-4722-b98b-05cc28307437",
      "summary": "The FDA released a congressionally mandated report under the Modernization of Cosmetics Regulation Act of 2022 (MoCRA) evaluating PFAS in cosmetic products. The report found insufficient toxicological data to definitively determine the safety of most PFAS, underscoring significant data gaps. The FDA will continue to monitor the issue and address data gaps, but no specific federal regulations prohibiting PFAS in cosmetics currently exist.",
      "key_regulations": [
        "Modernization of Cosmetics Regulation Act of 2022",
        "MoCRA"
      ],
      "key_entities": [
        "FDA",
        "CDC",
        "EPA",
        "U.S. Department of Health and Human Services"
      ],
      "regulatory_action_type": "administrative",
      "deadline": null
    },
    {
      "id": "68ed970f-0458-4510-b775-096b1cdb78d3",
      "item_id": "e8493c5e-26d8-4bb6-85d9-384afbd53378",
      "summary": "The FDA's Office of Food Additive Safety issued an updated guidance document detailing the chemistry recommendations for preparing premarket submissions for Food Contact Substances (FCS). The guidance provides industry instructions for completing Food Contact Notifications (FCNs) and Food Additive Petitions (FAPs), covering areas such as substance identity, technical effect, migration testing protocols, analytical method validation, and consumer exposure calculation.",
      "key_regulations": [
        "21 CFR 170.39",
        "21 CFR 175.300",
        "21 CFR 176.170"
      ],
      "key_entities": [
        "Food and Drug Administration",
        "Office of Food Additive Safety",
        "Human Foods Program"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": null
    },
