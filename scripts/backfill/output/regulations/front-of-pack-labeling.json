  "enrichments": [
    {
      "id": "02dc9f4c-e9f6-40ab-9669-7d9e3d6a3f7d",
      "item_id": "11faea33-b2cc-49c3-9773-aa10a1e4c982",
      "summary": "The FDA is requesting comments regarding information collection activities related to food labeling requirements, specifically calorie labeling for food in vending machines and nutrition labeling for standard menu items in restaurants and similar retail food establishments. This is a submission for Office of Management and Budget review.",
      "key_regulations": [
        "Food Labeling Requirements"
      ],
      "key_entities": [
        "Office of Management and Budget",
        "FDA"
      ],
      "regulatory_action_type": "administrative",
      "deadline": "2024-05-13"
    },
    {
      "id": "50d6efa0-e896-4867-b683-b27031b2752e",
      "item_id": "29cc58ed-68cd-4df6-af86-74960658e1c0",
      "summary": "The FDA issued a guidance document (Redbook 2000, Chapter VI.B) detailing the principles of epidemiology used by CFSAN for the safety assessment of food ingredients. The guidance outlines the types of descriptive and analytic epidemiology studies (e.g., cross-sectional, prospective, retrospective, and meta-analyses) and explains how these studies should be utilized to support food safety evaluations and health claims on food labeling.",
      "key_regulations": [
        "Nutrition Labeling and Education Act of 1990"
      ],
      "key_entities": [
        "Food and Drug Administration",
        "Center for Food Safety and Applied Nutrition (CFSAN)",
        "Adverse Reaction Monitoring System (ARMS)",
        "MedWatch"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": null
    },
    {
      "id": "9c46af84-94c7-4b27-97b0-c1c8c2560852",
      "item_id": "37b3ee34-efda-43a4-847d-6cebcf4475aa",
      "summary": "The FDA is revising its 2008 guidance on labeling for restaurants and retail establishments to incorporate the final rules for Nutrition Labeling of Standard Menu Items and Calorie Labeling of Articles of Food in Vending Machines (79 FR 71155 and 79 FR 71259).",
      "key_regulations": [
        "21 CFR 101.11",
        "79 FR 71155",
        "79 FR 71259"
      ],
      "key_entities": [
        "Food and Drug Administration"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": null
    },
    {
      "id": "2993410c-c931-43f7-ba69-d60e930f7622",
      "item_id": "4b42ece5-8069-4fe8-8367-930103516c3d",
      "summary": "The FDA has extended the comment period for the proposed rule regarding front-of-package nutrition labeling. The new deadline to submit comments is July 15, 2025.",
      "key_regulations": [
        "21 CFR Part 101"
      ],
      "key_entities": [],
      "regulatory_action_type": "administrative",
      "deadline": "2025-07-15"
    },
    {
      "id": "fd1404b2-9104-4b36-91d0-ae7038cd9ee1",
      "item_id": "4d71e0d0-22b8-4c4e-870b-939ffb42230e",
      "summary": "The FDA issued a Small Entity Compliance Guide to assist manufacturers in complying with dietary supplement labeling regulations established under DSHEA. The guidance clarifies the requirements for the 'Supplement Facts' panel, declaration of serving sizes, % Daily Values, proprietary blends, botanical common names, and specifies formatting standards and exemption criteria for small businesses.",
      "key_regulations": [
        "21 CFR 101.9",
        "21 CFR 101.36"
      ],
      "key_entities": [
        "Food and Drug Administration",
        "Center for Food Safety and Applied Nutrition",
        "Office of Food Labeling"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": "1999-03-23"
    },
    {
      "id": "e45ae411-8f08-463b-ad71-2caeac9d9c04",
      "item_id": "68fbabfa-0d8c-46a5-9d5f-80005d60d48c",
      "summary": "The FDA issued a supplemental guidance document for the food industry regarding menu labeling requirements for covered establishments like restaurants and retail food establishments. The guidance covers calorie disclosures, distinguishing menus from marketing materials, and announces enforcement discretion for the 'calories from fat' declaration requirement under 21 CFR 101.11.",
      "key_regulations": [
        "21 CFR 101.11",
        "21 U.S.C. 343",
        "21 CFR 10.115"
      ],
      "key_entities": [
        "Food and Drug Administration",
        "Human Foods Program"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": null
    },
    {
      "id": "4728b806-a44d-493e-a649-bdcdbec89a56",
      "item_id": "6946013e-1ebc-4920-a9aa-514c9a1929d0",
      "summary": "The FDA issued a guidance letter to food manufacturers and distributors reminding them that front-of-package symbols can constitute explicit or implied nutrient content claims. These claims must comply with 21 CFR 101.13 and Subpart D of Part 101, including the necessity of disclosure statements when foods contain high levels of fat, saturated fat, cholesterol, or sodium.",
      "key_regulations": [
        "21 CFR 101.13",
        "21 CFR 101 Subpart D"
      ],
      "key_entities": [
        "Food and Drug Administration",
        "Center for Food Safety and Applied Nutrition",
        "Office of Nutrition, Labeling and Dietary Supplements"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": null
    },
    {
      "id": "af736134-1701-4448-8388-69c1f8fb6949",
      "item_id": "71f1818b-6734-4b6a-8719-4bc22b3d5da0",
      "summary": "The FDA issued a Small Entity Compliance Guide to help small businesses comply with the final rule requiring the declaration of trans fatty acids in the nutrition labels of conventional foods and dietary supplements under 21 CFR 101.9 and 101.36. The rule takes effect on January 1, 2006, and mandates that trans fat be listed on a separate line under saturated fat.",
      "key_regulations": [
        "21 CFR 101.9",
        "21 CFR 101.36"
      ],
      "key_entities": [
        "Food and Drug Administration (FDA)",
        "Center for Food Safety and Applied Nutrition (CFSAN)",
        "Center for Science in the Public Interest",
        "Institute of Medicine of the National Academy of Sciences (IOM/NAS)"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": "2006-01-01"
    },
    {
      "id": "a200665c-4e81-4f7f-abf2-05ecf173f6d9",
      "item_id": "77a3bfbd-25cb-468a-bd3e-077129b87ce4",
      "summary": "The FDA issued a Small Entity Compliance Guide to assist restaurants and similar retail food establishments in complying with the final rule on nutrition labeling. The rule, effective December 1, 2015, requires chains with 20 or more locations to provide calorie and other nutrition information for standard menu items.",
      "key_regulations": [
        "21 CFR 101.11"
      ],
      "key_entities": [
        "Food and Drug Administration"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": "2015-12-01"
    },
    {
      "id": "0a738d6b-5fd6-4dd6-9388-c6c2c84644b8",
      "item_id": "8cc643f4-2e53-4ff2-bbeb-5da24132530a",
      "summary": "The FDA issued a final guidance document addressing how conventional food and dietary supplement manufacturers should declare small amounts of nutrients and dietary ingredients on nutrition labels. The guidance explains the FDA's enforcement discretion policy regarding conflicts between compliance with 21 CFR 101.9(c) and 101.9(g).",
      "key_regulations": [
        "21 CFR 101.9(c)",
        "21 CFR 101.9(g)"
      ],
      "key_entities": [
        "Food and Drug Administration (FDA)"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": null
    },
    {
      "id": "4cbedbe3-0d03-471d-821b-ab0500639490",
      "item_id": "99e3f32b-eae1-45b1-82bb-f2b52890ea98",
      "summary": "The FDA has published a final guidance document formatted as questions and answers to assist domestic and foreign industry stakeholders in properly labeling dietary supplements. The guide clarifies existing requirements under the Dietary Supplement Health and Education Act (DSHEA) and 21 CFR 101, including statement of identity, nutrition labeling, ingredient labeling, and allowable claims.",
      "key_regulations": [
        "21 CFR 101",
        "21 CFR 10.115"
      ],
      "key_entities": [
        "Food and Drug Administration",
        "Division of Dietary Supplement Programs",
        "Office of Nutritional Products, Labeling, and Dietary Supplements",
        "Center for Food Safety and Applied Nutrition"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": null
    },
    {
      "id": "d239c4a7-f9f4-4231-b615-7c7415ff5c30",
      "item_id": "a74a1ced-2996-485c-b381-8b4b85909536",
      "summary": "FDA guidance explaining the requirements for small businesses to file for an exemption from mandatory nutrition labeling for low-volume packaged foods and dietary supplements, including sales, employee, and unit thresholds.",
      "key_regulations": [
        "21 CFR 101.9",
        "21 CFR 101.36"
      ],
      "key_entities": [
        "Food and Drug Administration",
        "Center for Food Safety and Applied Nutrition",
        "Office of Nutritional Products, Labeling and Dietary Supplements"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": null
    },
    {
      "id": "c2b006c3-cfa4-4cfc-adbf-e8efa585432f",
      "item_id": "aabe7177-f413-4d1d-8272-1f817f8a000a",
      "summary": "The FDA issued a guidance manual detailing procedures for food manufacturers to develop, use, and voluntarily submit nutrition labeling databases. It provides statistical methodologies (e.g., computing 95% prediction intervals), sampling plans, and laboratory analysis guidelines to help ensure product labels comply with FDA nutrient declaration requirements under 21 CFR 101.9(g).",
      "key_regulations": [
        "21 CFR 101.9(g)",
        "21 CFR 101.9(b)",
        "21 CFR 101.9(c)",
        "21 CFR 101.12(b)"
      ],
      "key_entities": [
        "Food and Drug Administration (FDA)",
        "Center for Food Safety and Applied Nutrition (CFSAN)",
        "Human Foods Program",
        "AOAC International"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": null
    },
    {
      "id": "60e72ce2-5d7c-4f50-a4ab-c6d56b2e243f",
      "item_id": "be00523d-c88e-4bd6-b9d5-a33c99a854f9",
      "summary": "The FDA has issued a proposed rule to establish a new requirement for front-of-package nutrition labeling on food products. This rule would amend 21 CFR Part 101. The agency is accepting comments on the proposal until May 16, 2025.",
      "key_regulations": [
        "21 CFR Part 101"
      ],
      "key_entities": [
        "FDA"
      ],
      "regulatory_action_type": "compliance_requirement",
      "deadline": "2025-05-16"
    },
    {
      "id": "10a5b0ba-c6f4-4be1-b1de-f58ccdd48556",
      "item_id": "c2f61bb7-1eae-4048-a5b0-c90ec16fed21",
      "summary": "The FDA issued a Guidance for Industry acting as a Food Labeling Guide to assist manufacturers, distributors, and importers. The document summarizes the required statements for food labels under the FD&C Act and Fair Packaging and Labeling Act, addressing common questions regarding nutrition and allergen labeling, nutrient content claims, and health messages.",
