    {
      "id": "96ee39f2-baba-492e-bebe-9104c206459e",
      "item_id": "4cbb8d4c-8126-4970-8094-acdd11c4e29a",
      "summary": "The FDA issued a draft guidance in 2013 providing non-binding recommendations for Cosmetic Good Manufacturing Practices (GMPs), incorporating aspects of the ISO 22716:2007 standard. A May 2023 update notes that the FDA intends to withdraw or revise and reissue this draft guidance based on new GMP rulemaking required by the Modernization of Cosmetics Regulation Act of 2022 (MoCRA).",
      "key_regulations": [
        "Modernization of Cosmetics Regulation Act of 2022"
      ],
      "key_entities": [
        "Food and Drug Administration",
        "International Cooperation on Cosmetic Regulations (ICCR)",
        "International Organization for Standardization (ISO)"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": null
    },
    {
      "id": "1d03a987-000b-4a7a-9ea4-1a7f11a4cd77",
      "item_id": "87365d38-bc10-48f5-9671-3929f7a75e40",
      "summary": "The FDA issued a guidance document announcing a six-month delay in the enforcement of cosmetic product facility registration and cosmetic product listing requirements under MoCRA. This extension is intended to give owners, operators, and responsible persons adequate time to submit the required information.",
      "key_regulations": [
        "21 CFR 10.115(g)(2)",
        "21 CFR 10.115(g)(5)",
        "Modernization of Cosmetics Regulation Act of 2022 (MoCRA)",
        "Federal Food, Drug, and Cosmetic Act (FD&C Act)"
      ],
      "key_entities": [
