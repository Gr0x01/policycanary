  "enrichments": [
    {
      "id": "9d490758-94ce-4dfa-a433-5b9e54aafed1",
      "item_id": "02d77b22-3a7b-4214-973c-64aff3949bea",
      "summary": "FDA Import Alert 99-45 authorizes the Detention Without Physical Examination (DWPE) of food products, including dietary supplements, that contain unsafe food additives. A food is deemed adulterated if it contains an additive that does not conform to a food additive regulation, an effective food contact notification, or an exemption. The extensive Red List targets firms exporting products containing unauthorized substances such as Lead and Cadmium in ceramics, Cyclamates in snacks and juices, Coumarin in vanilla extracts, and unapproved botanicals or chemicals (e.g., Ashwagandha, Kratom, Yohimbine, DMAA, Folic Acid) in conventional foods and beverages.",
      "key_regulations": [
        "Section 402(a)(2)(C)(i)",
        "Section 409",
        "Section 801(a)(3)"
      ],
      "key_entities": [
        "Food and Drug Administration",
        "Division of Import Operations (DIO)",
        "Center for Food Safety and Applied Nutrition (CFSAN)"
      ],
      "regulatory_action_type": "import_violation",
      "deadline": null
    },
    {
      "id": "0ad10ca6-35ec-4b63-a150-d733c730e21d",
      "item_id": "53bdb11e-08cf-4de2-8c3f-8eab2cf65350",
      "summary": "The FDA updated Compliance Policy Guide Sec 540.500, which provides enforcement criteria for excessive levels of the food additive sodium nitrite in smoked and cured fish. Legal action is recommended if sodium nitrite concentrations exceed 15 ppm in tuna or 220 ppm in salmon, sable, and shad.",
      "key_regulations": [
        "21 CFR 172.175"
      ],
      "key_entities": [
        "CFSAN",
        "Food and Drug Administration",
        "Division of Enforcement"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": null
    },
    {
      "id": "d4017b88-17a0-45d3-8ff5-df5d7b3d360c",
      "item_id": "f0dd5ffc-2a38-438c-aba3-bad281f1a123",
      "summary": "The FDA issued a Compliance Policy Guide (CPG Sec 540.200) outlining regulatory action criteria for adulteration involving sodium nitrite in hot process smoked chubs. Legal action is recommended if the sodium nitrite concentration in the loin muscle exceeds 220 ppm.",
      "key_regulations": [
        "21 CFR 172.177"
      ],
      "key_entities": [
        "Office of Inspections and Investigations",
        "Human Foods Program",
        "CFSAN",
        "Division of Enforcement"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": null
    }
  ],
