    {
      "id": "eaa318f1-aad7-4d38-aa33-4f431563597f",
      "item_id": "a8ecb304-6022-4f96-9614-ab7bf1fbac33",
      "summary": "The FDA issued a warning letter to Umbrella for marketing and selling multiple products as dietary supplements that are classified as unapproved new drugs and are misbranded. Violative products include 'Alpha Male Plus', which contains the undeclared drug tadalafil; Kratom and Tianeptine products with illegal disease claims; a NACET product marketed to mitigate COVID-19; and numerous Selective Androgen Receptor Modulators (SARMs) promoted for human use with drug claims.",
      "key_regulations": [
        "FD&C Act Section 505(a) [21 U.S.C. § 355(a)]",
        "FD&C Act Section 301(d) [21 U.S.C. § 331(d)]",
        "FD&C Act Section 502 [21 U.S.C. § 352]"
      ],
      "key_entities": [
        "Umbrella",
        "Brendan Mullins"
      ],
      "regulatory_action_type": "cgmp_violation",
      "deadline": null
    },
    {
      "id": "a02a1c67-67a5-415c-a7d9-b2956c9e21e7",
      "item_id": "afee6d5a-fd20-4543-b6e5-e617dbce52ed",
      "summary": "The FDA issued a warning letter to Shot of Joy LLC for marketing kratom and kava products with unapproved drug claims. The company's website claimed its products could treat serious conditions including opioid addiction, anxiety, depression, PTSD, and ADHD, rendering them unapproved new drugs under the FD&C Act. The FDA highlighted the significant public health threat posed by such unproven treatments, especially concerning the opioid crisis.",
      "key_regulations": [
        "21 U.S.C. 355(a)",
