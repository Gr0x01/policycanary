        "Center for Drug Evaluation and Research",
        "Federal Trade Commission"
      ],
      "regulatory_action_type": "cgmp_violation",
      "deadline": "2022-06-30"
    },
    {
      "id": "220538a7-91b6-4322-8125-a487cd0d0a9f",
      "item_id": "a319d1b7-bad9-4ade-94b1-8debf5015d3a",
      "summary": "The FDA is withdrawing a previous notice regarding a proposed collection of information concerning the risk and safety considerations, as well as motivations, for the purchase and use of Kratom and psychedelics, both alone and in combination with other substances.",
      "key_regulations": [],
