  "enrichments": [
    {
      "id": "3d6da08a-0671-43c4-a6a6-d5ea460707b3",
      "item_id": "10c50511-fec2-40da-a5f5-7d8be2f12062",
      "summary": "The FDA issued a warning letter to Sunshine Trading Company, Inc. (dba Nova Kratom) for selling kratom products as unapproved new drugs. The company's website made illegal claims that the products could treat opioid addiction and withdrawal, relieve pain, anxiety, and depression, and manage conditions like fibromyalgia and cancer. The FDA stated these products pose a significant threat to public health, particularly amid the opioid crisis, as they have not been proven safe or effective for any medical use.",
      "key_regulations": [
        "FD&C Act Section 505(a)",
        "FD&C Act Section 301(d)",
        "FD&C Act Section 201(g)(1)",
        "FD&C Act Section 201(p)"
      ],
      "key_entities": [
        "Sunshine Trading Company, Inc.",
        "Nova Tea",
        "Nova Kratom",
        "Joshua Miller"
      ],
      "regulatory_action_type": "safety_alert",
      "deadline": null
    },
    {
      "id": "223f67ff-ebbc-4404-9245-105304a9ee31",
      "item_id": "1250faf2-4196-4a4b-87e5-89411f3cf068",
      "summary": "FDA Import Alert 54-15 authorizes the Detention Without Physical Examination (DWPE) of dietary supplements and bulk dietary ingredients containing Kratom (Mitragyna speciosa). The FDA considers Kratom to be a New Dietary Ingredient (NDI) that lacks adequate evidence of safety, making products containing it adulterated. The alert includes a RED LIST of numerous foreign manufacturers and domestic importers whose shipments are subject to immediate detention.",
      "key_regulations": [
        "21 U.S.C. 342",
        "21 U.S.C. 350b",
        "21 U.S.C. 321"
      ],
      "key_entities": [
        "U.S. Food and Drug Administration",
        "Division of Import Operations (DIO)",
        "Center for Food Safety and Applied Nutrition (CFSAN)"
      ],
      "regulatory_action_type": "import_violation",
      "deadline": null
    },
    {
      "id": "3d294834-6610-422b-bdb5-25a38adf2c83",
      "item_id": "19d04564-708d-44a3-a806-36e70a48c58d",
      "summary": "The FDA is requesting comments on proposed information collection activities concerning the risk/safety considerations and motivations for the purchase and use of kratom and psychedelics, both alone and in combination with other substances.",
      "key_regulations": [],
      "key_entities": [
