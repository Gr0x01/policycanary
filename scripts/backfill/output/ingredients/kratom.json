      "deadline": "2024-10-01"
    },
    {
      "id": "549957fc-d0f2-491e-ab96-53cc196433ca",
      "item_id": "19f87ea9-8a6d-4a25-94b0-005c7dc157a7",
      "summary": "The FDA and FTC issued a joint warning letter to Herbsens Botanicals for selling various kratom products with unapproved drug claims. The company's website promoted its kratom capsules and powders for treating serious conditions, including opioid addiction and withdrawal, pain, depression, diabetes, and high blood pressure. These claims render the products unapproved new drugs under the Federal Food, Drug, and Cosmetic Act. The FTC also demanded the company cease making unsubstantiated treatment claims, which violate the FTC Act. The company was given 15 working days to correct the violations.",
      "key_regulations": [
        "Federal Food, Drug, and Cosmetic Act (FD&C Act)",
        "Federal Trade Commission Act (FTC Act)"
      ],
      "key_entities": [
        "Herbsens Botanicals",
        "Center for Drug Evaluation and Research (CDER)",
        "Federal Trade Commission (FTC)"
      ],
      "regulatory_action_type": "cgmp_violation",
      "deadline": "2022-07-26"
    },
    {
      "id": "ae918218-60ec-43a0-bc29-aea1cf46addc",
      "item_id": "3ffacdd2-366f-427c-bca4-5d4cee86cc95",
      "summary": "The FDA and FTC issued a joint warning letter to Omni Consumer Products LLC (d/b/a YoKratom) for marketing various kratom powder and capsule products as unapproved new drugs. The company's website made explicit disease claims, including that their products could treat opioid addiction, withdrawal symptoms, pain, and depression. These claims classify the products as drugs under the FD&C Act. As these products lack FDA approval for safety and efficacy, their sale in interstate commerce is illegal. The letter requires the company to cease making these claims and correct the violations within 15 working days.",
      "key_regulations": [
        "21 U.S.C. 355(a)",
        "21 U.S.C. 331(d)",
        "21 U.S.C. 321(g)(1)",
        "21 U.S.C. 321(p)",
        "FTC Act (15 U.S.C. §§ 41–57)",
        "Opioid Addiction Recovery Fraud Prevention Act of 2018 (15 U.S.C. § 45d)"
      ],
      "key_entities": [
        "Omni Consumer Products LLC",
        "YoKratom",
        "Center for Drug Evaluation and Research (CDER)",
        "Federal Trade Commission (FTC)"
      ],
      "regulatory_action_type": "cgmp_violation",
      "deadline": null
    },
    {
      "id": "21737ebe-8cb5-45da-b835-a259a15e84c8",
      "item_id": "7daee674-9349-458b-af44-3a418908de0b",
      "summary": "The FDA and FTC jointly issued a warning letter to Kratom Exchange for selling various kratom powder products with unapproved drug claims. The company's website and social media promoted these products for treating serious conditions, including opioid addiction, withdrawal symptoms, depression, and high blood pressure. These claims render the products unapproved new drugs, sold in violation of the Federal Food, Drug, and Cosmetic (FD&C) Act. The agencies have demanded that the company cease making these illegal claims and provide a written response detailing corrective actions within 15 working days.",
      "key_regulations": [
        "FD&C Act Section 505(a)",
        "FD&C Act Section 301(d)",
        "FTC Act"
      ],
      "key_entities": [
        "Kratom Exchange",
        "FDA",
        "FTC",
        "Center for Drug Evaluation and Research"
      ],
      "regulatory_action_type": "cgmp_violation",
      "deadline": null
    },
    {
      "id": "d2ca6ce9-b17c-4c57-8e29-19ac3fb906dc",
      "item_id": "96e6c7b8-8fec-40c7-9e15-825a3673cc08",
      "summary": "The FDA and FTC issued a joint warning letter to Klarity Kratom for illegally selling kratom products with unapproved drug claims. The company's website promoted its products for treating opioid addiction, withdrawal symptoms, rheumatoid arthritis, and pain, causing the products to be classified as unapproved new drugs under the FD&C Act. The company was instructed to correct the violations within 15 working days or face potential legal action.",
      "key_regulations": [
        "FD&C Act Section 505(a)",
        "FD&C Act Section 301(d)",
        "FD&C Act Section 201(g)(1)",
        "FTC Act"
      ],
      "key_entities": [
