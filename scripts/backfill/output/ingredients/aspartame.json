  "enrichments": [
    {
      "id": "9d490758-94ce-4dfa-a433-5b9e54aafed1",
      "item_id": "02d77b22-3a7b-4214-973c-64aff3949bea",
      "summary": "FDA Import Alert 99-45 authorizes the Detention Without Physical Examination (DWPE) of food products, including dietary supplements, that contain unsafe food additives. A food is deemed adulterated if it contains an additive that does not conform to a food additive regulation, an effective food contact notification, or an exemption. The extensive Red List targets firms exporting products containing unauthorized substances such as Lead and Cadmium in ceramics, Cyclamates in snacks and juices, Coumarin in vanilla extracts, and unapproved botanicals or chemicals (e.g., Ashwagandha, Kratom, Yohimbine, DMAA, Folic Acid) in conventional foods and beverages.",
      "key_regulations": [
        "Section 402(a)(2)(C)(i)",
        "Section 409",
        "Section 801(a)(3)"
      ],
      "key_entities": [
        "Food and Drug Administration",
        "Division of Import Operations (DIO)",
        "Center for Food Safety and Applied Nutrition (CFSAN)"
      ],
      "regulatory_action_type": "import_violation",
      "deadline": null
    },
    {
      "id": "5c6ffdaa-27f8-409b-86e3-997526a268fd",
      "item_id": "604a06d3-8cca-4117-96ba-72ca73db412e",
      "summary": "The FDA issued a safety alert warning consumers about numerous pain and arthritis products, often falsely marketed as dietary supplements, food, or all-natural treatments, that contain dangerous and undeclared drug ingredients. These fraudulent products pose serious health risks, including severe health issues and hospitalization, and are not guaranteed to be effective. The alert provides a list of specific products found to contain hidden drug ingredients, such as Artri Ajo Rev, ULTRA ADVANC3, and various others, with one product, OneMultivitaminic GAF-Plus Advance, also containing undeclared aspartame.",
      "key_regulations": [],
      "key_entities": [
        "FDA"
      ],
      "regulatory_action_type": "safety_alert",
      "deadline": null
    },
    {
      "id": "705c220c-6186-49d2-b632-0c6f0967d448",
      "item_id": "a24e936e-61d8-458b-a049-04428bf51ca4",
      "summary": "Sodexo Stars Saccharin (Pink) Packets, a sugar substitute manufactured by Domino Foods, Inc., has been recalled due to the presence of undeclared Aspartame.",
      "key_regulations": [],
      "key_entities": [
        "Sodexo Stars",
        "Domino Foods, Inc."
      ],
      "regulatory_action_type": "recall",
      "deadline": null
    },
    {
      "id": "f0531796-ec66-4bd4-811b-fdcbe47da3bd",
      "item_id": "b0e56ce7-cae6-4ac5-b421-45aff3be02df",
      "summary": "OneMultivitaminic GAF-PLUS Advance 300ml is being recalled due to the presence of undeclared drugs Acetaminophen and Dexamethasone Phosphate, and the undeclared sweetener Aspartame.",
      "key_regulations": [],
      "key_entities": [],
      "regulatory_action_type": "recall",
      "deadline": null
    }
  ],
