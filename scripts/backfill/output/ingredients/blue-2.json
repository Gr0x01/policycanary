  "enrichments": [
    {
      "id": "8e3fb787-5c61-4b70-b685-ea6422ab9ef8",
      "item_id": "0160be68-7057-4932-a641-b4f9187b7e6b",
      "summary": "The Candy Basket, Inc. is recalling Marionberry Jelly Sticks DARK (item number CB745-D) sold in bulk 4lb. boxes due to undeclared Red #3, Blue #1, Potassium Sorbate, and Propylene Glycol. The product was sold to consumers from bulk chocolate cases without proper labeling.",
      "key_regulations": [],
      "key_entities": [
        "The Candy Basket, Inc."
      ],
      "regulatory_action_type": "recall",
      "deadline": null
    },
    {
      "id": "aca63acf-a1cc-4d94-9c67-f8272acb3441",
      "item_id": "0211a9b4-382b-4c39-9883-d5e90d337a6c",
      "summary": "The FDA issued a warning letter to Picket Fence Creamery LLC for significant misbranding violations on their ice cream and cheese curd products. The company failed to declare ingredients and sub-ingredients on product labels, including major allergens such as wheat flour, eggs, and almonds. The letter also noted improper placement of color additives on the label and potential violations regarding Nutrition Facts panels and the statement of the place of business. The company was given 15 working days to provide a written response detailing corrective actions.",
      "key_regulations": [
        "21 U.S.C. § 343(i)(2)",
        "21 CFR 101.4"
      ],
      "key_entities": [
        "Picket Fence Creamery LLC"
      ],
      "regulatory_action_type": "cgmp_violation",
      "deadline": null
    },
    {
      "id": "8a76d134-7b72-4691-93c0-7c9b527ac0e6",
      "item_id": "0caced00-fee6-448b-a464-0a3a88ced9fb",
      "summary": "Chocolate Peanut Butter Protein Balls are being recalled due to undeclared soy lecithin and a variety of undeclared color additives including Blue 1 Lake, Yellow 6, Red 40, Yellow 5, Blue 1, Yellow 6 Lake, Red 40 Lake, Yellow 5 Lake, Blue 2 Lake, and Blue 2.",
      "key_regulations": [],
      "key_entities": [],
      "regulatory_action_type": "recall",
      "deadline": null
    },
    {
      "id": "b0fe1f1f-d67c-4fc2-a7c6-4c92f1d3c3cf",
      "item_id": "20c2f87d-5141-4fed-8153-aa7f17f24959",
      "summary": "The FDA issued a warning letter to Sheng Kee Bakery detailing significant violations of Current Good Manufacturing Practice and Preventive Controls regulations (21 CFR Part 117) at its Brisbane, CA facility. The inspection revealed the absence of a required food safety plan to control for hazards such as allergens, Salmonella, and mycotoxins. The facility was also cited for severe pest infestations, poor employee hygiene, and other insanitary conditions. Multiple products were found to be misbranded and adulterated due to undeclared ingredients, including the major food allergen 'egg' and unlisted color additives like FD&C Yellow No. 5 and No. 6.",
      "key_regulations": [
        "21 CFR Part 117",
        "21 CFR Part 101",
        "Federal Food, Drug, and Cosmetic Act Section 402",
        "Federal Food, Drug, and Cosmetic Act Section 403"
      ],
      "key_entities": [
        "Sheng Kee of California, Inc dba Sheng Kee Bakery",
        "Center for Food Safety and Applied Nutrition (CFSAN)"
      ],
      "regulatory_action_type": "cgmp_violation",
      "deadline": null
    },
