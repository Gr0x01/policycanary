  "enrichments": [
    {
      "id": "91ca2011-3589-44b8-a288-d4e7a4432d1d",
      "item_id": "5f936d44-6bc1-4129-bce4-d5493afff77f",
      "summary": "The FDA issued a warning letter to Invisi Smart Technologies UK LTD for marketing unapproved medical devices, specifically the 'Invisi Smart Mask,' with claims of mitigating and preventing COVID-19. The products were deemed adulterated and misbranded because they lacked the necessary FDA marketing approval, clearance, or authorization. The company was instructed to cease the sale of these products in the U.S. and was warned that the devices are subject to detention and refusal of admission upon import.",
      "key_regulations": [
        "21 U.S.C. § 321(h)",
        "21 U.S.C. § 351(f)(1)(B)",
        "21 U.S.C. § 352(o)",
        "21 U.S.C. § 360(k)"
      ],
      "key_entities": [
        "Invisi Smart Technologies UK LTD",
        "Center for Devices and Radiological Health"
      ],
      "regulatory_action_type": "import_violation",
      "deadline": null
    },
    {
      "id": "a48f9fa0-540f-4587-b782-7bbcb7995f64",
      "item_id": "d4012c53-04f8-4cd6-9935-c04778e7024f",
      "summary": "FDA Center for Drug Evaluation and Research (CDER) issued a Small Entity Compliance Guide for OTC sunscreen drug products. It clarifies labeling rules, SPF and Broad Spectrum testing requirements, and compliance dates for the 2011 sunscreen final rule (21 CFR 201.327). Sunscreens marketed without an NDA/ANDA containing specific active ingredients such as avobenzone, titanium dioxide, or zinc oxide must adhere to standard labeling and in vitro/in vivo testing formats to make claims like 'Broad Spectrum' and 'Water Resistant'.",
      "key_regulations": [
        "21 CFR 201.327"
      ],
      "key_entities": [
        "Center for Drug Evaluation and Research",
        "Food and Drug Administration"
      ],
      "regulatory_action_type": "guidance_update",
      "deadline": "2013-12-17"
    },
    {
      "id": "d59ad5d5-9096-4946-868e-ec1e459cb6cc",
      "item_id": "ebb1c896-e92f-41e5-bdcc-af96a2823928",
      "summary": "The FDA issued a warning letter to Mr. Lulu LLC for significant CGMP violations at its drug manufacturing facility. An inspection revealed the firm failed to conduct release testing for active ingredients (zinc oxide, titanium dioxide) in its OTC sunscreen products, failed to test incoming components, used food-grade instead of USP-grade titanium dioxide, lacked process validation, used a personal kitchen mixer for manufacturing, and did not have a Quality Unit. The company has committed to ceasing drug production and must provide a corrective action plan.",
      "key_regulations": [
        "21 CFR 210",
        "21 CFR 211",
        "21 CFR 211.165(a)",
        "21 CFR 211.84(d)(1)",
        "21 CFR 211.84(d)(2)",
        "21 CFR 211.100(a)",
        "21 CFR 211.188",
        "21 CFR 211.22"
      ],
      "key_entities": [
        "Mr. Lulu LLC",
        "Roi Chairat"
      ],
      "regulatory_action_type": "cgmp_violation",
      "deadline": "2023-06-22"
    }
  ],
